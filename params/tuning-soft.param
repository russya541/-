# Soft starter PID / attitude tuning for Pixhawk 2.4.8 (ArduCopter)
# Conservative values for first hover. Retune after reviewing logs.
# Apply after baseline + failsafe files.

# Angle P
ATC_ANG_PIT_P,4.5
ATC_ANG_RLL_P,4.5
ATC_ANG_YAW_P,4.5

# Rate pitch
ATC_RAT_PIT_P,0.10
ATC_RAT_PIT_I,0.10
ATC_RAT_PIT_D,0.0035
ATC_RAT_PIT_FF,0.0
ATC_RAT_PIT_IMAX,0.5
ATC_RAT_PIT_FLTT,20
ATC_RAT_PIT_FLTE,0
ATC_RAT_PIT_FLTD,20

# Rate roll
ATC_RAT_RLL_P,0.10
ATC_RAT_RLL_I,0.10
ATC_RAT_RLL_D,0.0035
ATC_RAT_RLL_FF,0.0
ATC_RAT_RLL_IMAX,0.5
ATC_RAT_RLL_FLTT,20
ATC_RAT_RLL_FLTE,0
ATC_RAT_RLL_FLTD,20

# Rate yaw
ATC_RAT_YAW_P,0.18
ATC_RAT_YAW_I,0.018
ATC_RAT_YAW_D,0.0
ATC_RAT_YAW_FF,0.0
ATC_RAT_YAW_IMAX,0.5
ATC_RAT_YAW_FLTT,20
ATC_RAT_YAW_FLTE,2.5
ATC_RAT_YAW_FLTD,20

# Input shaping / filters
ATC_INPUT_TC,0.20
ATC_THR_MIX_MAN,0.5
ATC_THR_MIX_MIN,0.1
ATC_THR_MIX_MAX,0.5

# Position / altitude controllers (soft)
PSC_POSXY_P,1.0
PSC_VELXY_P,2.0
PSC_VELXY_I,1.0
PSC_VELXY_D,0.5
PSC_POSZ_P,1.0
PSC_VELZ_P,5.0
PSC_ACCZ_P,0.3
PSC_ACCZ_I,1.0

# Autotune readiness (do not enable mid-flight accidentally)
AUTOTUNE_AXES,7
AUTOTUNE_AGGR,0.075
AUTOTUNE_MIN_D,0.0005
