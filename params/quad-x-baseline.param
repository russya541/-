# Quad X baseline for Pixhawk 2.4.8 (ArduCopter)
# Load in Mission Planner: Full Parameter List → Load
# Review values before Write Params. Units follow ArduPilot conventions.

FRAME_CLASS,1
FRAME_TYPE,1

# Arming / safety
ARMING_CHECK,1
ARMING_RUDDER,2
ARMING_ACCTHRESH,0.75

# Serial / GPS (typical Pixhawk 2.4.8: GPS on SERIAL3)
SERIAL3_PROTOCOL,5
SERIAL3_BAUD,38
GPS_TYPE,1
GPS_AUTO_SWITCH,1

# Logging
LOG_BACKEND_TYPE,1
LOG_BITMASK,176126
LOG_DISARMED,0
LOG_FILE_DSRMROT,1

# AHRS / EKF basics
AHRS_EKF_TYPE,3
EK3_ENABLE,1
EK2_ENABLE,0

# Compass (enable primary; recalibrate after load)
COMPASS_ENABLE,1
COMPASS_USE,1
COMPASS_AUTODEC,1

# Battery monitor via power module (calibrate voltage/current in MP)
BATT_MONITOR,4
BATT_VOLT_PIN,2
BATT_CURR_PIN,3
BATT_VOLT_MULT,10.1
BATT_AMP_PERVLT,17.0

# Default flight modes (ch5): Stabilize, AltHold, Loiter, RTL, Auto, Land
FLTMODE_CH,5
FLTMODE1,0
FLTMODE2,2
FLTMODE3,5
FLTMODE4,6
FLTMODE5,3
FLTMODE6,9

# Throttle behavior
THR_DZ,100
PILOT_SPEED_UP,250
PILOT_SPEED_DN,150
PILOT_ACCEL_Z,250

# Motors
MOT_PWM_TYPE,0
MOT_SPIN_ARM,0.10
MOT_SPIN_MIN,0.15
MOT_SPIN_MAX,0.95
MOT_THST_EXPO,0.65
